# ──────────────────────────────────────────────
# Whisker & Brew cat café — backend environment variables
# ──────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL). Leave unset to use SQLite in development.
# DATABASE_URL=postgres://pos_user:pos_password@localhost:5432/cat_cafe

# Redis / Celery. Set CELERY_ENABLED=true when a worker is running;
# otherwise kitchen tickets print synchronously.
REDIS_URL=redis://localhost:6379/0
CELERY_ENABLED=false

# Where guests' phones open the frontend. Table QR codes encode
# {PUBLIC_BASE_URL}/t/{token}, so use the café's LAN IP or domain — never
# localhost (a phone can't reach "localhost" on your machine).
PUBLIC_BASE_URL=http://192.168.1.20:5173

# Frontend origins allowed to call the API (comma-separated).
# PUBLIC_BASE_URL is added automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Allowed Hosts (comma-separated, production only)
ALLOWED_HOSTS=localhost,127.0.0.1

# Café branding (shown on the QR menu, table tents and landing page)
CAFE_NAME=Whisker & Brew
CAFE_TAGLINE=Coffee, cake and cats who choose you.
CAFE_WIFI=WhiskerGuest
CAFE_OPENING_HOURS=Mon–Fri 10:00–20:00;Sat–Sun 09:00–21:00
CAFE_FACEBOOK_URL=
CAFE_INSTAGRAM_URL=
CAFE_TIKTOK_URL=

# Printing: also print a kitchen ticket when staff create a POS order.
# (QR orders always print when staff confirm them.)
KITCHEN_AUTO_PRINT_POS=false

# Bookings
BOOKING_SLOT_MINUTES=60
BOOKING_MAX_GUESTS_PER_SLOT=12
BOOKING_DAY_START=10:00
BOOKING_DAY_END=20:00

# Rate limits for guest endpoints and staff login
PUBLIC_THROTTLE_RATE=120/min
LOGIN_THROTTLE_RATE=10/min

# Production / Docker
# Plain-HTTP café LAN? Set DJANGO_HTTPS=false (no HTTPS redirect, no HSTS).
DJANGO_HTTPS=true
# Origins allowed to POST to /admin (defaults to PUBLIC_BASE_URL).
# CSRF_TRUSTED_ORIGINS=http://192.168.1.20:8080
# Password for the Postgres container in docker-compose.yml.
POSTGRES_PASSWORD=change-me
