# ──────────────────────────────────────────────
# Whisker & Brew frontend — environment variables
# ──────────────────────────────────────────────

# API root. "/api/v1" goes through the Vite dev proxy (see vite.config.ts),
# which is what phones on the café Wi-Fi need. Leave EMPTY for an offline demo
# of the staff dashboard on bundled mock data (guest pages need the API).
VITE_API_URL=/api/v1

# Where the proxy forwards /api and /media (the Django server).
VITE_BACKEND_URL=http://127.0.0.1:8000
